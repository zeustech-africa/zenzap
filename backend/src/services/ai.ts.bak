import OpenAI from 'openai';

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

export interface AIResponse {
  suggestedReplies: string[];
  sentiment: 'positive' | 'neutral' | 'negative';
  intent: 'question' | 'complaint' | 'purchase' | 'booking' | 'greeting' | 'other';
  confidence: number;
}

class AIService {
  async analyzeMessage(message: string, context?: string): Promise<AIResponse> {
    try {
      const prompt = `
        Analyze this customer message and provide:
        1. 3 suggested replies (short, professional, helpful)
        2. Sentiment (positive/neutral/negative)
        3. Intent (question/complaint/purchase/booking/greeting/other)
        4. Confidence score (0-100)

        Customer message: "${message}"
        ${context ? `Business context: ${context}` : ''}

        Respond in JSON format:
        {
          "suggestedReplies": ["reply1", "reply2", "reply3"],
          "sentiment": "positive|neutral|negative",
          "intent": "question|complaint|purchase|booking|greeting|other",
          "confidence": 95
        }
      `;

      const response = await openai.chat.completions.create({
        model: 'gpt-3.5-turbo',
        messages: [{ role: 'user', content: prompt }],
        temperature: 0.7,
        response_format: { type: 'json_object' }
      });

      const result = JSON.parse(response.choices[0].message.content || '{}');
      
      return {
        suggestedReplies: result.suggestedReplies || [
          "Thank you for your message. How can I help you today?",
          "I'll look into that for you right away.",
          "Thanks for reaching out!"
        ],
        sentiment: result.sentiment || 'neutral',
        intent: result.intent || 'other',
        confidence: result.confidence || 80
      };
    } catch (error) {
      console.error('AI analysis failed:', error);
      return {
        suggestedReplies: [
          "Thank you for your message. How can I help you today?",
          "I'll get back to you shortly.",
          "Thanks for reaching out!"
        ],
        sentiment: 'neutral',
        intent: 'other',
        confidence: 50
      };
    }
  }

  async generateResponse(message: string, businessContext: string): Promise<string> {
    try {
      const prompt = `
        Generate a helpful, professional response to this customer message.
        Business context: ${businessContext}
        Customer message: "${message}"
        
        Response should be: friendly, concise, and helpful. Keep it under 150 characters.
      `;

      const response = await openai.chat.completions.create({
        model: 'gpt-3.5-turbo',
        messages: [{ role: 'user', content: prompt }],
        temperature: 0.7,
        max_tokens: 100
      });

      return response.choices[0].message.content || "Thank you for your message. How can I help?";
    } catch (error) {
      console.error('AI response generation failed:', error);
      return "Thank you for your message. How can I help you today?";
    }
  }

  async detectLanguage(message: string): Promise<string> {
    try {
      const response = await openai.chat.completions.create({
        model: 'gpt-3.5-turbo',
        messages: [
          { role: 'user', content: `Detect the language of this message. Reply with only the language name (English, Afrikaans, isiZulu, isiXhosa, or Other): "${message}"` }
        ],
        temperature: 0,
        max_tokens: 20
      });
      
      return response.choices[0].message.content || 'English';
    } catch (error) {
      return 'English';
    }
  }
}

export const aiService = new AIService();